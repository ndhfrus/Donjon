  <DisembarkPerk identifier="slotcoilgunturret" cost="1" sortcategory="Turrets" mutuallyexclusiveperks="slotchaingunturret,slotpulselaser">
    <SubItemSwapPerk targetitem="turrethardpoint" replacementitem="coilgun"/>
    <SpawnItemPerk identifier="coilgunammobox" MinAmount="3" PriorityContainerTag="coilgunammosource" />
    <SpawnItemPerk identifier="coilgunharpoonbox" MinAmount="2"/>
  </DisembarkPerk>

  <DisembarkPerk identifier="slotchaingunturret" cost="2" sortcategory="Turrets" mutuallyexclusiveperks="slotcoilgunturret,slotpulselaser">
