  <!-- Ивент сет - ОСОБЫЕ -->
  <!-- Разнообразные ивенты, к примеру для тех игроков, которые обожают брать руками горячие слитки, либо уничтожение тканой одежды в огне -->
  <!-- Будет по - своему реагировать в зависимости от ситуации -->
  <EventSet identifier="clothing_damage_random" commonness="0" chooserandom="false" triggereventcooldown="false">
    <!-- В огне! Сильно жечь тканую одежду -->
    <ScriptedEvent identifier="clothing_onfire" commonness="0" triggereventcooldown="false">
      <CheckItemAction
          targettag="damaged_character"
          itemtags="clothgear"
          amount="1"
          requireworn="true"
          recursive="true"
          applytagtoitem="clothing_to_damage">
