                          <Sound file="%ModDir%/Sounds/woodhit_02.ogg" selectionmode="random" range="600" />
                          <Sound file="%ModDir%/Sounds/woodhit_03.ogg" selectionmode="random" range="600" />
                        </StatusEffect>
                        <StatusEffect type="Always" target="This" disabledeltatime="true" condition="-1" comparison="and" delay="2.4">
                          <Sound file="%ModDir%/Sounds/woodhit_01.ogg" selectionmode="random" range="600" />
                          <Sound file="%ModDir%/Sounds/woodhit_02.ogg" selectionmode="random" range="600" />
                          <Sound file="%ModDir%/Sounds/woodhit_03.ogg" selectionmode="random" range="600" />
                        </StatusEffect>
                      </StatusEffectAction>
                      <StatusEffectAction targettag="training">
                        <StatusEffect type="Always" target="This" disabledeltatime="true" comparison="and">
                          <Affliction identifier="incrementalstun" strength="25" probability="0.66" />
                        </StatusEffect>
                        <StatusEffect type="Always" target="This" disabledeltatime="true" comparison="and" delay="1.2">
                          <Affliction identifier="incrementalstun" strength="25" probability="0.66" />
                        </StatusEffect>
                        <StatusEffect type="Always" target="This" disabledeltatime="true" comparison="and" delay="2.4">
                          <Affliction identifier="incrementalstun" strength="25" probability="0.66" />
                        </StatusEffect>
                      </StatusEffectAction>
                      <WaitAction time="3" />
                      <ConversationAction targettag="training" text="textevent.trainingfail">
                        <Option text="textevent.trainingbad" endconversation="true" />
                      </ConversationAction>
                    </Failure>
                  </RNGAction>
                </Option>
                <Option text="textevent.trainingno" endconversation="true" />
              </ConversationAction>
            </Failure>
            <Success>
              <ConversationAction targettag="training" text="textevent.trainingexehausted">
                <Option text="textevent.traininglater" endconversation="true" />
              </ConversationAction>
            </Success>
          </CheckAfflictionAction>
        </Success>
      </CheckItemAction>
    </ScriptedEvent>
