            <StatusEffect type="Always" target="This" condition="-6" disabledeltatime="true" />
          </StatusEffectAction>
        </Success>
      </CheckItemAction>
    </ScriptedEvent>
    <!-- Горячая заготовка, слиток и тд уничтожает не кожаные перчатки -->
    <ScriptedEvent identifier="clothing_hotinhands" commonness="0" triggereventcooldown="false">
      <CheckItemAction
          targettag="damaged_character"
          itemtags="armorhands,armorlimbs"
          amount="1"
          requireworn="true"
          recursive="true"
          applytagtoitem="clothing_to_damage">
        <Success>
          <StatusEffectAction targettag="clothing_to_damage">
            <StatusEffect type="Always" target="This" condition="-10" disabledeltatime="true">
              <ParticleEmitter particle="MistSmoke" particleamount="3" anglemin="0" anglemax="360" distancemin="0" distancemax="0" velocitymin="0" velocitymax="20" scalemin="0.6" scalemax="0.7" />
              <particleemitter particle="weldspark" drawontop="true" particleamount="7" velocitymin="100" velocitymax="500" anglemin="0" anglemax="360" distancemin="0" distancemax="20" scalemin="0.4" scalemax="1.0" />
              <Conditional hastag="irongear"/>
              <Conditional hastag="steelgear"/>
              <Conditional hastag="coppergear"/>
              <Conditional hastag="bronzegear"/>
              <Conditional hastag="clothgear"/>
            </StatusEffect>
          </StatusEffectAction>
        </Success>
      </CheckItemAction>
    </ScriptedEvent>
    <!-- Работа в шахте повреждает металлические доспехи носимые чтобы не робастили -->
    <ScriptedEvent identifier="clothing_notforwork" commonness="0" triggereventcooldown="false">
      <CheckItemAction
          targettag="working_character"
          itemtags="armorlimbs,armortorso,armorhands"
          amount="1"
          requireworn="true"
          recursive="true"
          applytagtoitem="clothing_to_damage">
        <Success>
          <StatusEffectAction targettag="clothing_to_damage">
            <StatusEffect type="Always" target="This" condition="-1" disabledeltatime="true" comparison="or">
              <Conditional hastag="irongear"/>
              <Conditional hastag="steelgear"/>
              <Conditional hastag="coppergear"/>
              <Conditional hastag="bronzegear"/>
              <ParticleEmitter particle="MistSmoke" particleamount="1" anglemin="0" anglemax="360" distancemin="0" distancemax="0" velocitymin="0" velocitymax="20" scalemin="0.6" scalemax="0.8" />
            </StatusEffect>
          </StatusEffectAction>
        </Success>
      </CheckItemAction>
    </ScriptedEvent>
    <!-- Сбросить с орка неподходящие ему вещи (тканые игнорируются) -->
    <ScriptedEvent identifier="clothing_notforork" commonness="0" triggereventcooldown="false">
      <CheckItemAction
          targettag="ork_event"
          itemtags="clothing"
          amount="1"
          requireworn="true"
          recursive="true"
          applytagtoitem="want_to_drop">
        <!-- Проверяем теги каждого найденного предмета -->
        <Conditional hastag="neq clothgear"/>
        <Conditional hastag="neq orksuitable"/>
        <Success>
          <StatusEffectAction targettag="want_to_drop">
            <StatusEffect type="Always" target="This" disabledeltatime="true" comparison="and">
              <DropItem/>
            </StatusEffect>
          </StatusEffectAction>
        </Success>
      </CheckItemAction>
    </ScriptedEvent>
  </EventSet>
  <!-- Ивент сет - СПАВНЕРЫ -->
  <!-- Вообще должен был быть отдельный файл, но мне впадлу. -->
  <EventSet identifier="spawner" commonness="0" chooserandom="false" triggereventcooldown="false">
    <!-- Спавнер КАБАНЫ -->
    <!-- До 5 штук -->
    <ScriptedEvent identifier="boar_spawner_cycle">
      <Label name="cycle_start" />
      <!-- Пауза в 2 минуты, в 10 минут, в 30 минут -->
      <RNGAction chance="0.333333">
        <Success>
          <WaitAction time="120" />
        </Success>
        <Failure>
          <RNGAction chance="0.5">
            <Success>
              <WaitAction time="600" />
            </Success>
            <Failure>
              <WaitAction time="1800" />
            </Failure>
          </RNGAction>
        </Failure>
      </RNGAction>
      <!-- Поиск игроков -->
      <TagAction criteria="players" tag="boar_humans" continueifnotargetsfound="true" />
      <TagAction criteria="humanprefabtag:human" tag="boar_humans" continueifnotargetsfound="true" />
      <!-- В пределах 30 метров от игроков кабаны не захотят спавниться -->
      <TriggerAction
        target1tag="boar_spawner"
        target2tag="boar_humans"
        type="Outside"
        radius="2000"
        checkalltargets="true"
        disableincombat="false"
        disableiftargetincapacitated="true" />
      <!-- Спавн до пяти кабанов на карту -->
      <StatusEffectAction targettag="boar_spawner">
        <StatusEffect type="Always" target="This">
          <SpawnCharacter speciesname="kaban" count="1" totalmaxcount="5" spread="100" />
        </StatusEffect>
      </StatusEffectAction>
      <GoTo name="cycle_start" />
    </ScriptedEvent>
    <!-- Спавнер СКЕЛЕТЫ -->
    <!-- До 6 штук -->
    <ScriptedEvent identifier="skeleton_spawner_cycle">
      <Label name="cycle_start" />
      <!-- Пауза в 2 минуты, в 5 минут, в 10 минут -->
      <RNGAction chance="0.333333">
        <Success>
          <WaitAction time="120" />
        </Success>
        <Failure>
          <RNGAction chance="0.5">
            <Success>
              <WaitAction time="300" />
            </Success>
            <Failure>
              <WaitAction time="600" />
            </Failure>
          </RNGAction>
        </Failure>
      </RNGAction>
      <!-- Поиск игроков -->
      <TagAction criteria="players" tag="skeleton_humans" continueifnotargetsfound="true" />
      <TagAction criteria="humanprefabtag:human" tag="skeleton_humans" continueifnotargetsfound="true" />
      <!-- В пределах 20 метров от игроков скелеты не захотят спавниться -->
      <TriggerAction
        target1tag="skeletom_spawner"
        target2tag="skeleton_humans"
        type="Outside"
        radius="2000"
        checkalltargets="true"
        disableincombat="false"
        disableiftargetincapacitated="true" />
      <!-- Спавн до пяти кабанов на карту -->
      <StatusEffectAction targettag="skeleton_spawner">
        <StatusEffect type="Always" target="This">
          <SpawnCharacter speciesname="skeleton" count="1" totalmaxcount="6" spread="100" />
        </StatusEffect>
      </StatusEffectAction>
      <GoTo name="cycle_start" />
    </ScriptedEvent>
    <!-- Спавнер ВОЛЧАРЫ -->
    <!-- До 3 штук -->
    <ScriptedEvent identifier="wolf_spawner_cycle">
      <Label name="cycle_start" />
      <!-- Пауза в 10 минут, в 30 минут, в 60 минут -->
      <RNGAction chance="0.333333">
        <Success>
          <WaitAction time="1200" />
        </Success>
        <Failure>
          <RNGAction chance="0.5">
            <Success>
              <WaitAction time="3600" />
            </Success>
            <Failure>
              <WaitAction time="7200" />
            </Failure>
          </RNGAction>
        </Failure>
      </RNGAction>
      <!-- Поиск игроков -->
      <TagAction criteria="players" tag="wolf_humans" continueifnotargetsfound="true" />
      <TagAction criteria="humanprefabtag:human" tag="wolf_humans" continueifnotargetsfound="true" />
      <!-- В пределах 20 метров от игроков волки не захотят спавниться -->
      <TriggerAction
        target1tag="wolf_spawner"
        target2tag="wolf_humans"
        type="Outside"
        radius="2000"
        checkalltargets="true"
        disableincombat="false"
        disableiftargetincapacitated="true" />
      <!-- Спавн до пяти кабанов на карту -->
      <StatusEffectAction targettag="wolf_spawner">
        <StatusEffect type="Always" target="This">
          <SpawnCharacter speciesname="wolf" count="3" totalmaxcount="3" spread="100" />
        </StatusEffect>
      </StatusEffectAction>
      <GoTo name="cycle_start" />
    </ScriptedEvent>
  </EventSet>

  <!-- Ивент сет - ТЕЛЕПОРТ К ТОРГОВЦУ -->
  <EventSet identifier="teleports" commonness="0" chooserandom="false" triggereventcooldown="false">
