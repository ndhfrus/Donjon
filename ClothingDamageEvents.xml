                            </Failure>
                          </SkillCheckAction>
                        </Success>
                        <Failure>
                          <ConversationAction targettag="training" text="textevent.trainingsuccess">
                            <Option text="textevent.traininggood" endconversation="true" />
                          </ConversationAction>
                        </Failure>
                      </SkillCheckAction>
                    </Success>
                    <Failure>
                      <StatusEffectAction targettag="training_weapon">
