                            </Success>
                            <Failure>
                              <StatusEffectAction targettag="training">
                                <StatusEffect type="Always" target="This" disabledeltatime="true" comparison="and">
                                  <GiveSkill skillidentifier="weapons" amount="0.1" triggertalents="true" />
                                </StatusEffect>
                              </StatusEffectAction>
                              <ConversationAction targettag="training" text="textevent.trainingcapsuccess">
                                <Option text="textevent.traininggood" endconversation="true" />
