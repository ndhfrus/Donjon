        <sprite name="FaceAttachment 7" texture="Content/Characters/Human/Human_head_accessories.png" sheetindex="2,1" />
      </Wearable>
      <Wearable type="FaceAttachment" commonness="0.02">
        <sprite name="FaceAttachment 8" texture="Content/Characters/Human/Human_head_accessories.png" sheetindex="3,1" />
      </Wearable>
      <Wearable type="FaceAttachment" commonness="0.01">
        <sprite name="FaceAttachment 13" texture="Content/Characters/Human/Human_head_accessories.png" sheetindex="0,3" />
      </Wearable>
      <Wearable type="FaceAttachment" commonness="0.01">
        <sprite name="FaceAttachment 14" texture="Content/Characters/Human/Human_head_accessories.png" sheetindex="1,3" />
      </Wearable>
      <Wearable type="FaceAttachment" commonness="0.01">
        <sprite name="FaceAttachment 15" texture="Content/Characters/Human/Human_head_accessories.png" sheetindex="2,3" />
      </Wearable>
      <!--
    <Wearable type="FaceAttachment" commonness="1.0">
      <sprite name="FaceAttachment 16" texture="Content/Characters/Human/Human_head_accessories.png" sheetindex="3,3"/>
    </Wearable>
    -->
      <Wearable type="Husk">
        <sprite name="Husk" texture="Content/Characters/Human/Human_husk.png" hidewearablesoftype="Beard" sheetindex="0,0" />
      </Wearable>
      <Wearable type="Herpes">
        <sprite name="Herpes" texture="Content/Characters/Human/Human_karma.png" sheetindex="0,0" />
      </Wearable>
    </HeadAttachments>
    <!-- В ОГНЕ! Ломай ему одежду -->
    <StatusEffect type="OnFire" target="Character" interval="0.5">
      <TriggerEvent identifier="clothing_onfire" />
    </StatusEffect>
    <!-- Звук при смерти -->
    <StatusEffect type="OnDeath" target="Character" comparison="and">
      <Conditional islocalplayer="eq true"/>
      <Sound file="%ModDir%/Medical/game_over.ogg" range="5000" volume="1" selectionmode="Random" />
    </StatusEffect>
    <!-- Опыт-->
    <StatusEffect type="OnActive" target="Character" Comparison="And" interval="60" disabledeltatime="true">
      <Conditional IsPlayer="true" />
      <GiveExperience amount="10" />
    </StatusEffect>
    <!-- Не дает умереть в течении трех минут после падения. НЕ ЗАЩИЩАЕТ от ваншотов. -->
    <StatusEffect type="OnActive" target="Character" interval="0.5" disabledeltatime="true">
      <Conditional vitality="lt 0" />
      <Affliction identifier="critical_defence" strength="1" />
    </StatusEffect>
    <!-- Голодание (обычное) -->
    <StatusEffect type="OnActive" target="Character" Comparison="And" interval="20" disabledeltatime="true">
      <Conditional IsPlayer="true" />
      <Affliction identifier="hunger" strength="0.2" />
    </StatusEffect>
    <!-- Тег НЕ ДВИГАЕТСЯ -->
    <StatusEffect type="OnActive" target="This" disabledeltatime="true" comparison="and" delay="2.5">
      <Conditional speed="lte 1" />
      <Conditional canrun="eq false" />
    </StatusEffect>
    <!-- Получение урона дает усталость. Чем выше урон тем сильнее! -->
    <StatusEffect type="OnDamaged" target="This" disabledeltatime="true">
      <RequiredAffliction type="damage" minstrength="10" />
      <Conditional hasstatustag="neq less_pain"/>
      <Affliction identifier="incrementalstun" strength="8" penetration="1" />
    </StatusEffect>
    <StatusEffect type="OnDamaged" target="This" disabledeltatime="true">
      <RequiredAffliction type="damage" minstrength="20" />
      <Conditional hasstatustag="neq less_pain"/>
      <Affliction identifier="incrementalstun" strength="20" penetration="1" />
    </StatusEffect>
    <StatusEffect type="OnDamaged" target="This" disabledeltatime="true">
      <RequiredAffliction type="damage" minstrength="50" />
      <Conditional hasstatustag="neq less_pain"/>
      <Affliction identifier="incrementalstun" strength="60" penetration="1" />
    </StatusEffect>
    <!-- Получение урона дает усталость с талантом. Чем выше урон тем сильнее! -->
    <StatusEffect type="OnDamaged" target="This" disabledeltatime="true">
      <RequiredAffliction type="damage" minstrength="10" />
      <Conditional hasstatustag="eq less_pain"/>
      <Affliction identifier="incrementalstun" strength="4" penetration="1" />
    </StatusEffect>
    <StatusEffect type="OnDamaged" target="This" disabledeltatime="true">
      <RequiredAffliction type="damage" minstrength="20" />
      <Conditional hasstatustag="eq less_pain"/>
      <Affliction identifier="incrementalstun" strength="10" penetration="1" />
    </StatusEffect>
    <StatusEffect type="OnDamaged" target="This" disabledeltatime="true">
      <RequiredAffliction type="damage" minstrength="50" />
      <Conditional hasstatustag="eq less_pain"/>
      <Affliction identifier="incrementalstun" strength="30" penetration="1" />
    </StatusEffect>
    <!-- Превращение в отродье если до смерти недавно кусал вампир ИЛИ если 100% голода у обычного вампира -->
    <StatusEffect type="OnDeath" target="This" disabledeltatime="true" comparison="or">
      <Conditional vamp_bite="gt 1" />
      <Conditional vampirismneedblood="gte 100" />
      <SpawnCharacter speciesname="Vamp_Spawn" Stun="1.5" stun="True" RemovePreviousCharacter="True" TransferInventory="True" />
    </StatusEffect>
    <!-- Превращение в гуля при смерти с очень высоким голодом -->
    <StatusEffect type="OnDeath" target="This" disabledeltatime="true" comparison="and" delay="2.5">
      <Conditional hunger="gte 100" />
      <Conditional hunger_elite="gte 300" />
      <SpawnCharacter speciesname="ghoul" Stun="1.5" stun="True" RemovePreviousCharacter="True" TransferInventory="True" />
    </StatusEffect>
    <!-- СТАТЬ ДУХОМ! -->
    <StatusEffect type="OnDeath" target="This" disabledeltatime="true" comparison="and">
      <Conditional mana_drain="gte 99" />
      <Conditional hasstatustag="neq redteam"/>
      <Conditional hasstatustag="neq safezone"/>
      <DropContainedItems/>
      <Explosion range="100.0" force="0" disablefireeffects="true" smoke="false" flames="false" sparks="false" camerashake="0.0" playtinnitus="false" flashrange="800" flashduration="1.5" flashcolor="255,0,255,255" />
      <ParticleEmitter particle="swirlysmoke" particleamount="40" scalemin="0.5" scalemax="0.9" velocitymin="100" velocitymax="500" anglemin="0" anglemax="360" distancemin="0" distancemax="0" lifetimemultiplier="0.25" colormultiplier="255,0,255,255" copyentityangle="false" />
      <Sound file="%ModDir%/Sounds/spiritcast.ogg" selectionmode="random" range="1200" />
      <ParticleEmitter particle="enchantment" AngleMax="360" DistanceMin="50" DistanceMax="90" ScaleMultiplier="0.6,0.6" EmitInterval="1" ParticleAmount="15" Distance="80" ColorMultiplier="255,0,255,255" />
      <Spawncharacter SpeciesName="Ghost" count="1" TransferBuffs="false" TransferAfflictions="false" TransferInventory="false" RemovePreviousCharacter="true" TransferControl="true"/>
    </StatusEffect>
    <!-- СТАТЬ ДУХОМ! но красным -->
    <StatusEffect type="OnDeath" target="This" disabledeltatime="true" comparison="and">
      <Conditional mana_drain="gte 99" />
      <Conditional hasstatustag="eq redteam"/>
      <Conditional hasstatustag="neq safezone"/>
      <DropContainedItems/>
      <Explosion range="100.0" force="0" disablefireeffects="true" smoke="false" flames="false" sparks="false" camerashake="0.0" playtinnitus="false" flashrange="800" flashduration="1.5" flashcolor="255,0,255,255" />
      <ParticleEmitter particle="swirlysmoke" particleamount="40" scalemin="0.5" scalemax="0.9" velocitymin="100" velocitymax="500" anglemin="0" anglemax="360" distancemin="0" distancemax="0" lifetimemultiplier="0.25" colormultiplier="255,0,255,255" copyentityangle="false" />
      <Sound file="%ModDir%/Sounds/spiritcast.ogg" selectionmode="random" range="1200" />
      <ParticleEmitter particle="enchantment" AngleMax="360" DistanceMin="50" DistanceMax="90" ScaleMultiplier="0.6,0.6" EmitInterval="1" ParticleAmount="15" Distance="80" ColorMultiplier="255,0,255,255" />
      <Spawncharacter SpeciesName="Ghost_Red" count="1" TransferBuffs="false" TransferAfflictions="false" TransferInventory="false" RemovePreviousCharacter="true" TransferControl="true"/>
    </StatusEffect>
    <StatusEffect type="OnSpawn" target="This" delay="1">
      <GiveTalentInfo talentidentifiers="default_donjon_talent" />
    </StatusEffect>
  </Character>
</Override>