  <submarine.name.donjon2>AA_Donjon "Darkwood and Ridge" Hardcore</submarine.name.donjon2>
  <submarine.description.donjon2>This map has automatic lighting. There are no pre-installed boxes or workstations, and there are more monsters.</submarine.description.donjon2>
  <submarine.name.donjon3>AA_Donjon "Darkwood"</submarine.name.donjon3>
  <submarine.description.donjon3>This map has semi-automatic lighting. There are no monsters here.</submarine.description.donjon3>
  <submarine.name.donjon4>AA_Donjon "Ridge"</submarine.name.donjon4>
  <submarine.description.donjon4>This map has semi-automatic lighting. There are no monsters here.</submarine.description.donjon4>
  <submarine.name.donjon6>AA_Donjon "Farlands"</submarine.name.donjon6>
  <submarine.description.donjon6>This map features semi-automatic lighting. It features various monsters, workbenches, and even dungeons. This is how Donjon meant to be played.</submarine.description.donjon6>
